  m_Script: {fileID: 11500000, guid: ed413638dc688554fb795da575df2789, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OneHealth.ShowVisualCard
  itemId: 425
  indentLevel: 0
  title: "Debrief \u2014 Evidence"
  image: {fileID: 0}
  caption: You learned to separate observations from explanations. A possible connection
    is not proof of a common cause.
